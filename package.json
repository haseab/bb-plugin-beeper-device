{
  "name": "bb-plugin-beeper-device",
  "version": "0.1.0",
  "private": true,
  "description": "Read Beeper unread counts on an explicitly selected BB machine.",
  "homepage": "https://github.com/haseab/bb-plugin-beeper-device#readme",
  "bugs": {
    "url": "https://github.com/haseab/bb-plugin-beeper-device/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haseab/bb-plugin-beeper-device.git"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsrs --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "build": "bb plugin build",
    "format:check": "oxfmt --check *.ts *.json"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.132",
    "@types/node": "^22.20.5",
    "bb-app": "0.49.0",
    "better-sqlite3": "12.11.1",
    "cron-parser": "^5.10.4",
    "hono": "^4.13.16",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.91.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "vitest": "^4.1.12"
  },
  "engines": {
    "bb": ">=0.48.1",
    "bbPluginSdk": ">=0.6.132"
  },
  "bb": {
    "name": "Beeper Device",
